{
  "schemaVersion": 1,
  "id": "waypointlink",
  "version": "${version}",
  "name": "${name}",
  "description": "Sync waypoints from MCDR Location Marker to Xaero's Minimap. 手动同步 MCDR Location Marker 路径点到 Xaero's Minimap。",
  "authors": [
    "oneIdler",
    "renzaifei"
  ],
  "contact": {
    "sources": "https://github.com/SDK-Minecraft-Server/WaypointLink"
  },
  "license": "LGPLv3",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.oneidler.waypointlink.WaypointLinkMod"
    ],
    "client": [
      "com.oneidler.waypointlink.WaypointLinkMod",
      "com.oneidler.waypointlink.network.WaypointSyncHandler"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft_support}",
    "fabric-api": "*"
  }
}